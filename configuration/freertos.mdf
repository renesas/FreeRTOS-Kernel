<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
/***********************************************************************************************************************
  Purpose: Module Description File (MDF) Example (Schema Version 2.0)
           This is a description of a sample FIT module configuration file
***********************************************************************************************************************/
-->
<module xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="2.0" xs:noNamespaceSchemaLocation="schema_mdf_2.00.xsd">
    <fileVersion>1.00</fileVersion>
    <formatVersion>2.00</formatVersion>
    <fileTemplate></fileTemplate>
    <configuration>
        <property id="configCPU_CLOCK_HZ" display="The frequency of the CPU clock" default="BSP_ICLK_HZ" type="textbox">
            <constraint display="default disable" actionOnFail="disable">("${configCPU_CLOCK_HZ}" == BSP_ICLK_HZ)</constraint>
            <description>Sets the frequency in Hz at which the internal clock that drives the peripheral used to generate the tick interrupt will be executing.
This is normally the same clock that drives the internal CPU clock. This value is required in order to correctly configure timer peripherals.</description>
        </property>
        <property id="configPERIPHERAL_CLOCK_HZ" display="The frequency of the PERIPHERAL clock" default="BSP_PCLKB_HZ" type="textbox">
            <constraint display="default disable" actionOnFail="disable">("${configPERIPHERAL_CLOCK_HZ}" == BSP_PCLK_HZ)</constraint>
            <description>Sets the frequency of the peripheral clock.</description>
        </property>
        <property id="configTICK_RATE_HZ" display="The frequency of the RTOS tick interrupt" default="( TickType_t ) 1000" type="textbox">
            <description>Sets the frequency of RTOS tick interrupt. The tick interrupt is used to measure time. 
The RTOS demo applications all use a tick rate of 1000Hz. This is used to test the RTOS kernel and is higher than what would normally be required.
A high tick rate frequency will have the effect of reducing the 'time slice' given to each task.</description>
        </property>
        <property id="configUSE_PREEMPTION" display="RTOS scheduler" default="1" type="combobox">
            <option id="configUSE_PREEMPTION.0" display="Cooperative" value="0"/>
            <option id="configUSE_PREEMPTION.1" display="Preemptive" value="1"/>
            <description>Enable: Use the preemptive RTOS scheduler.
Disable: Use the cooperative RTOS scheduler.</description>
        </property>
        <property id="configUSE_TIME_SLICING" display="Time slicing" default="1" type="checkbox">
            <option id="configUSE_TIME_SLICING.0" display="Disable" value="0"/>
            <option id="configUSE_TIME_SLICING.1" display="Enable" value="1"/>
            <description>Enable: Include time slicing support.
Disable: Omit time slicing support.</description>
        </property>
        <property id="configUSE_PORT_OPTIMISED_TASK_SELECTION" display="Port optimised task selection" default="0" type="checkbox">
            <option id="configUSE_PORT_OPTIMISED_TASK_SELECTION.0" display="Disable" value="0"/>
            <option id="configUSE_PORT_OPTIMISED_TASK_SELECTION.1" display="Enable" value="1"/>
            <description>Enable: Include port optimised task selection support.
Disable: Omit port optimised task selection support.</description>
        </property>
        <property id="configUSE_TICKLESS_IDLE" display="Tickless idle" default="0" type="checkbox">
            <option id="configUSE_TICKLESS_IDLE.0" display="Disable" value="0"/>
            <option id="configUSE_TICKLESS_IDLE.1" display="Enable" value="1"/>
            <description>Enable: Include tickless idle support.
Disable: Omit tickless idle support. 
Note: Tickless idle is not supported in this version.</description>
        </property>
        <property id="configMAX_PRIORITIES" display="Maximum number of priorities to the application task" default="7" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configMAX_PRIORITIES}")</constraint>
            <constraint display="Value must be in the range 1 ~ 32">("${configMAX_PRIORITIES}" &gt;= 1) &amp;&amp; ("${configMAX_PRIORITIES}" &lt;= 32)</constraint>
            <description>Sets the number of priorities available to the application tasks. Multiple tasks can share the same priority. 
Co-routines are prioritised separately - see configMAX_CO_ROUTINE_PRIORITIES. 
Each available priority consumes RAM within the RTOS kernel so this value should not be set any higher than actually required by your application.</description>
        </property>
        <property id="configMINIMAL_STACK_SIZE" display="The size of the stack used by the idle task" default="( unsigned short ) 140" type="textbox">
            <description>Sets the minimum stack size which will also be used by the idle task.
Generally this value should not be smaller than the default value set in the FreeRTOSConfig.h file provided with the demo application for the port you are using.
The stack size is specified in words, not bytes.</description>
        </property>
        <property id="configMAX_TASK_NAME_LEN" display="The maximum permissible length of name" default="12" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configMAX_TASK_NAME_LEN}")</constraint>
            <constraint display="Value must be in the range 1 ~ 255">("${configMAX_TASK_NAME_LEN}" &gt;= 1) &amp;&amp; ("${configMAX_TASK_NAME_LEN}" &lt;= 255)</constraint>
            <description>Sets the maximum permissible length of task name given to a task when the it is created.
The length is specified in the number of characters including the NULL termination byte.</description>
        </property>
        <property id="configTICK_VECTOR" display="Tick vector" default="_CMT0_CMI0" type="combobox">
            <option id="configTICK_VECTOR._CMT0_CMI0" display="_CMT0_CMI0" value="_CMT0_CMI0"/>
            <option id="configTICK_VECTOR._CMT1_CMI1" display="_CMT1_CMI1" value="_CMT1_CMI1"/>
            <option id="configTICK_VECTOR._CMT2_CMI2" display="_CMT2_CMI2" value="_CMT2_CMI2"/>
            <option id="configTICK_VECTOR._CMT3_CMI3" display="_CMT3_CMI3" value="_CMT3_CMI3"/>
            <description>Select the peripheral used to generate the tick interrupt. This constant should be set to the vector number of the peripheral chosen. 
CMT0 is selected by default.</description>
        </property>
        <property id="configTICK_TYPE_WIDTH_IN_BITS" display="Tick type width" default="TICK_TYPE_WIDTH_32_BITS" type="combobox">
            <option id="configTICK_TYPE_WIDTH_IN_BITS.16" display="TICK_TYPE_WIDTH_16_BITS" value="TICK_TYPE_WIDTH_16_BITS"/>
            <option id="configTICK_TYPE_WIDTH_IN_BITS.32" display="TICK_TYPE_WIDTH_32_BITS" value="TICK_TYPE_WIDTH_32_BITS"/>
            <option id="configTICK_TYPE_WIDTH_IN_BITS.64" display="TICK_TYPE_WIDTH_64_BITS" value="TICK_TYPE_WIDTH_64_BITS"/>
            <description>Select 16/32/64-bit ticks. This controls the type and bit-width of TickType_t.</description>
        </property>
        <property id="configIDLE_SHOULD_YIELD" display="Idle should yield" default="1" type="checkbox">
            <option id="configIDLE_SHOULD_YIELD.0" display="Disable" value="0"/>
            <option id="configIDLE_SHOULD_YIELD.1" display="Enable" value="1"/>
            <description>Enable: Idle task will yield immediately if any other task at the idle priority is ready to run. That task will share the same time slice with idle task.
Disable: Prevents the idle task from yielding processing time until the end of time slice. This ensure all tasks at the idle priority are allocated an equal amount of processing time.</description>
        </property>
        <property id="configTASK_NOTIFICATION_ARRAY_ENTRIES" display="Task notification array entries" default="1" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configTASK_NOTIFICATION_ARRAY_ENTRIES}")</constraint>
            <constraint display="Value must be greater than 0">("${configTASK_NOTIFICATION_ARRAY_ENTRIES}" &gt; 0)</constraint>
            <description>Sets the number of task notification array entries.
This value defines how many separate task notification "slots" available to each task when using indexed task notification.
Generally this value should be left at 1 unless your application requires more than one independent notification per task, as increasing it increases the RAM used by each task.</description>
        </property>
        <property id="configQUEUE_REGISTRY_SIZE" display="Queue registry size" default="0" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configQUEUE_REGISTRY_SIZE}")</constraint>
            <constraint display="Value must be equal or greater than 0">("${configQUEUE_REGISTRY_SIZE}" &gt;= 0) </constraint>
            <description>configQUEUE_REGISTRY_SIZE defines the maximum number of queues and semaphores that can be registered. 
Only those queues and semaphores that you want to view using a RTOS kernel aware debugger need be registered.</description>
        </property>
        <property id="configENABLE_BACKWARD_COMPATIBILITY" display="Enable backward compatibility" default="1" type="checkbox">
            <option id="configENABLE_BACKWARD_COMPATIBILITY.0" display="Disable" value="0"/>
            <option id="configENABLE_BACKWARD_COMPATIBILITY.1" display="Enable" value="1"/>
            <description>Enable: Enable backward compatibility with older versions of FreeRTOS.
Disable: Disable backward compatibility with older versions of FreeRTOS.
When this is enabled, FreeRTOS provides legacy macro and API definitions to allow existing projects to compile without modification.</description>
        </property>
        <property id="configNUM_THREAD_LOCAL_STORAGE_POINTERS" display="Number of thread local storage pointers" default="0" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configNUM_THREAD_LOCAL_STORAGE_POINTERS}")</constraint>
            <constraint display="Value must be in the range 0 ~ 255">("${configNUM_THREAD_LOCAL_STORAGE_POINTERS}" &gt;= 0) &amp;&amp; ("${configNUM_THREAD_LOCAL_STORAGE_POINTERS}" &lt;= 255)</constraint>
            <description>Sets the number of thread local storage pointers that will be allocated for each task.
Each pointer provides a per-task storage location that can be set and read by the application.</description>
        </property>
        <property id="configUSE_MINI_LIST_ITEM" display="Use mini list item" default="1" type="checkbox">
            <option id="configUSE_MINI_LIST_ITEM.0" display="Disable" value="0"/>
            <option id="configUSE_MINI_LIST_ITEM.1" display="Enable" value="1"/>
            <description>Enable: Include the usage of MiniListItem_t as opposed to ListItem_t.
Disable: Omit the usage of MiniListItem_t.
Enabling this uses a smaller list item structure for the list end marker, reducing RAM usage for each list.</description>
        </property>
        <property id="configSTACK_DEPTH_TYPE" display="Stack depth type" default="StackType_t" type="textbox">
            <constraint display="default disable" actionOnFail="disable">("${configSTACK_DEPTH_TYPE}" == StackType_t)</constraint>
            <description>Sets the type used by the parameter to xTaskCreate which specifies the stack size of the task.</description>
        </property>
        <property id="configMESSAGE_BUFFER_LENGTH_TYPE" display="Message buffer length type" default="size_t" type="textbox">
            <constraint display="default disable" actionOnFail="disable">("${configMESSAGE_BUFFER_LENGTH_TYPE}" == size_t)</constraint>
            <description>Sets the type used to store the length of each message written to the FreeRTOS message buffer.</description>
        </property>
        <property id="configHEAP_CLEAR_MEMORY_ON_FREE" display="Heap clear memory on free" default="1" type="checkbox">
            <option id="configHEAP_CLEAR_MEMORY_ON_FREE.0" display="Disable" value="0"/>
            <option id="configHEAP_CLEAR_MEMORY_ON_FREE.1" display="Enable" value="1"/>
            <description>Enable: Include the support to clear a memory block upon vPortFree.
Disable: Omit the support to clear a memory block upon vPortFree.
This feature clears (set to zero) the memory returned to the heap by vPortFree before it becomes available for reallocation.
This will help to detect use-after-free issues and reduce the risk of heap corruption.</description>
        </property>
        <property id="configSTATS_BUFFER_MAX_LENGTH" display="Stats buffer max length" default="0xFFFF" type="textbox">
            <constraint display="Value must be an hexadecimal value">testHexInteger("${configSTATS_BUFFER_MAX_LENGTH}")</constraint>
            <description>Sets the maximum buffer length to be passed to vTaskList and vTaskGetRunTimeStats.</description>
        </property>
        <property id="configUSE_NEWLIB_REENTRANT" display="Use newlib reentrant" default="0" type="checkbox">
            <option id="configUSE_NEWLIB_REENTRANT.0" display="Disable" value="0"/>
            <option id="configUSE_NEWLIB_REENTRANT.1" display="Enable" value="1"/>
            <description>Enable: Include the usage of newlib reent structure for each task.
Disable: Omit the usage of newlib reent structure for each task.</description>
        </property>
        <property id="configUSE_TIMERS" display="Software timer functionality" default="1" type="checkbox">
            <option id="configUSE_TIMERS.0" display="Disable" value="0"/>
            <option id="configUSE_TIMERS.1" display="Enable" value="1"/>
            <description>Enable: Include software timer functionality.
Disable: Omit software timer functionality.</description>
        </property>
        <property id="configTIMER_TASK_PRIORITY" display="The priority of the software timer task" default="6" type="textbox">
            <constraint display="Value must be an integer ">testInteger("${configTIMER_TASK_PRIORITY}")</constraint>
            <constraint display="Value must be in the range 1 ~ 32">("${configTIMER_TASK_PRIORITY}" &gt;= 1) &amp;&amp; ("${configTIMER_TASK_PRIORITY}" &lt;= 32)</constraint>
            <constraint display="Value must be less than the maximum number of priorities to the application task">("${configTIMER_TASK_PRIORITY}" &lt; ${configMAX_PRIORITIES})</constraint>
            <description>Sets the priority of the software timer service/daemon task.
Timer task processes timer commands and executes software timer callback function. The priority affects how quickly callbacks run and time commands are handled.
The value must be less than configMAX_PRIORITIES.
See the FreeRTOS software timers page for a full description.</description>
        </property>
        <property id="configTIMER_TASK_STACK_DEPTH" display="The stack depth allocated to the software timer task" default="configMINIMAL_STACK_SIZE" type="textbox">
            <constraint display="default disable" actionOnFail="disable">("${configTIMER_TASK_STACK_DEPTH}" == configMINIMAL_STACK_SIZE)</constraint>
            <description>Sets the stack depth allocated to the software timer service/daemon task.
Timer task stack is used when processing timer commands and executing timer callback functions.
See the FreeRTOS software timers page for a full description.</description>
        </property>
        <property id="configTIMER_QUEUE_LENGTH" display="The length of the software timer command queue" default="5" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configTIMER_QUEUE_LENGTH}")</constraint>
            <constraint display="Value must be equal or greater than 0">("${configTIMER_QUEUE_LENGTH}" &gt;= 0)</constraint>
            <description>Sets the length of the software timer command queue.
Timer queue holds pending timer commands which were sent to the timer service task. Larger value allow more commands to be buffered.
See the FreeRTOS software timers page for a full description.</description>
        </property>
        <property id="configUSE_EVENT_GROUPS" display="Event groups" default="1" type="checkbox">
            <option id="configUSE_EVENT_GROUPS.0" display="Disable" value="0"/>
            <option id="configUSE_EVENT_GROUPS.1" display="Enable" value="1"/>
            <description>Enable: Include Event Group functionality.
Disable: Omit Event Group functionality.</description>
        </property>
        <property id="configUSE_STREAM_BUFFERS" display="Stream buffers" default="1" type="checkbox">
            <option id="configUSE_STREAM_BUFFERS.0" display="Disable" value="0"/>
            <option id="configUSE_STREAM_BUFFERS.1" display="Enable" value="1"/>
            <description>Enable: Include stream buffer functionality.
Disable: Omit stream buffer functionality.</description>
        </property>
        <property id="configSUPPORT_STATIC_ALLOCATION" display="Support static allocation" default="0" type="checkbox">
            <option id="configSUPPORT_STATIC_ALLOCATION.0" display="Disable" value="0"/>
            <option id="configSUPPORT_STATIC_ALLOCATION.1" display="Enable" value="1"/>
            <description>Enable: Support static allocation.
Disable: Disable static allocation.
When enabled, APIs that create objects using static memory will be made available.</description>
        </property>
        <property id="configSUPPORT_DYNAMIC_ALLOCATION" display="Support dynamic allocation" default="1" type="checkbox">
            <option id="configSUPPORT_DYNAMIC_ALLOCATION.0" display="Disable" value="0"/>
            <option id="configSUPPORT_DYNAMIC_ALLOCATION.1" display="Enable" value="1"/>
            <description>Enable: Support dynamic allocation.
Disable: Disable dynamic allocation.
If this is enabled, heap_*.c must be included in the project.</description>
        </property>
        <property id="configTOTAL_HEAP_SIZE_N" display="The configTOTAL_HEAP_SIZE_N" default="8" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configTOTAL_HEAP_SIZE_N}")</constraint>
            <constraint display="Heap size must be greater than 0">("${configTOTAL_HEAP_SIZE_N}" &gt; 0)</constraint>
            <constraint display="Heap size must be less than RAM capacity">("${configTOTAL_HEAP_SIZE_N}" &lt;= ${Device.ramSize})</constraint>
            <description>The total amount of RAM available in the FreeRTOS heap(Unit: Kbytes). The value is used for calculating HEAP_SIZE(Bytes) in following expression: 
( size_t ) ( configTOTAL_HEAP_SIZE_N * 1024 )</description>
        </property>
        <property id="configTOTAL_HEAP_SIZE" display="The total amount of RAM available in the FreeRTOS heap" default="( size_t ) ( configTOTAL_HEAP_SIZE_N * 1024 )" type="textbox">
            <constraint display="default disable" actionOnFail="disable">("${configTOTAL_HEAP_SIZE}" == ( size_t ) ( configTOTAL_HEAP_SIZE_N * 1024 ))</constraint>
            <description>This value will only be used if configSUPPORT_DYNAMIC_ALLOCATION is set to 1 and the application makes use of one of the sample memory allocation schemes provided in the FreeRTOS source code download.</description>
        </property>
        <property id="configAPPLICATION_ALLOCATED_HEAP" display="Application allocated heap" default="0" type="checkbox">
            <option id="configAPPLICATION_ALLOCATED_HEAP.0" display="Disable" value="0"/>
            <option id="configAPPLICATION_ALLOCATED_HEAP.1" display="Enable" value="1"/>
            <description>Enable: Include application allocated heap support.
Disable: Omit application allocated heap support.
When enabled, the application must define the heap array (for example, ucHeap[]) and FreeRTOS will use that memory for pvPortMalloc()/vPortFree().
Enable this option when you need explicit control over the heap placement, such as locating it in a specific RAM region or placing it with a custom linker script
Disable this to let the selected heap_*.c implementation provide the heap storage.</description>
        </property>
        <property id="configSTACK_ALLOCATION_FROM_SEPARATE_HEAP" display="Stack allocation from separate heap" default="0" type="checkbox">
            <option id="configSTACK_ALLOCATION_FROM_SEPARATE_HEAP.0" display="Disable" value="0"/>
            <option id="configSTACK_ALLOCATION_FROM_SEPARATE_HEAP.1" display="Enable" value="1"/>
            <description>Enable: Task stacks are allocated from an area outside of the FreeRTOS heap.
Disable: Task stacks are allocated from the FreeRTOS heap.
When enabled, you must provide custom implementations of pvPortMallocStack() and vPortFreeStack() to allocate and free task stacks from a separate memory region.
This is useful when you want to place task stacks in a specific memory area separate from the general-purpose heap used for other dynamic allocations.</description>
        </property>
        <property id="configENABLE_HEAP_PROTECTOR" display="Enable heap protector" default="0" type="checkbox">
            <option id="configENABLE_HEAP_PROTECTOR.0" display="Disable" value="0"/>
            <option id="configENABLE_HEAP_PROTECTOR.1" display="Enable" value="1"/>
            <description>Enable: Include bounds checking and obfuscation functionality.
Disable: Omit bounds checking and obfuscation functionality.
Heap protector implements extra checks and obfuscates heap block pointers to detect memory corruption issues such as buffer overflows, use-after-free, and heap structure corruption.
This provides additional safety at the cost of slightly increased RAM usage and processing overhead.</description>
        </property>
        <property id="configKERNEL_INTERRUPT_PRIORITY" display="Kernel interrupt priority" default="1" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configKERNEL_INTERRUPT_PRIORITY}")</constraint>
            <constraint display="Value must be in range 0 ~ configMAX_SYSCALL_INTERRUPT_PRIORITY - 1">("${configKERNEL_INTERRUPT_PRIORITY}" &gt;= 0) &amp;&amp; ("${configKERNEL_INTERRUPT_PRIORITY}" &lt;= ${configMAX_SYSCALL_INTERRUPT_PRIORITY} - 1)</constraint>
            <description>Sets the interrupt priority used by the kernel itself for the tick interrupt and the pended interrupt.  This would normally be the lowest priority.</description>
        </property>
        <property id="configMAX_SYSCALL_INTERRUPT_PRIORITY" display="Maximum syscall interrupt priority" default="4" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configMAX_SYSCALL_INTERRUPT_PRIORITY}")</constraint>
            <constraint display="Value must be in range configKERNEL_INTERRUPT_PRIORITY + 1 ~ configMAX_PRIORITIES - 1">("${configMAX_SYSCALL_INTERRUPT_PRIORITY}" &gt;= ${configKERNEL_INTERRUPT_PRIORITY} + 1) &amp;&amp; ("${configMAX_SYSCALL_INTERRUPT_PRIORITY}" &lt;= ${configMAX_PRIORITIES} - 1)</constraint>
            <description>The maximum interrupt priority from which FreeRTOS API calls can be made.
Interrupts that use a priority above this will not be effected by anything the kernel is doing.</description>
        </property>
        <property id="configUSE_IDLE_HOOK" display="Idle hook" default="1" type="checkbox">
            <option id="configUSE_IDLE_HOOK.0" display="Disable" value="0"/>
            <option id="configUSE_IDLE_HOOK.1" display="Enable" value="1"/>
            <description>Enable: Implements idle hook function.
Disable: Omit idle hook function.
When enabled, the application must define vApplicationIdleHook() which will be called on each iteration of the idle task.</description>
        </property>
        <property id="configUSE_TICK_HOOK" display="Tick hook" default="1" type="checkbox">
            <option id="configUSE_TICK_HOOK.0" display="Disable" value="0"/>
            <option id="configUSE_TICK_HOOK.1" display="Enable" value="1"/>
            <description>Enable: Implements tick hook.
Disable: Omit tick hook.</description>
        </property>
        <property id="configUSE_MALLOC_FAILED_HOOK" display="The malloc() failed function" default="1" type="checkbox">
            <option id="configUSE_MALLOC_FAILED_HOOK.0" display="Disable" value="0"/>
            <option id="configUSE_MALLOC_FAILED_HOOK.1" display="Enable" value="1"/>
            <description>Enable: Application must define a malloc() failed hook function.
Disable: The malloc() failed function will not be called, even if one is defined.
Malloc() failed hook functions must have the name and prototype shown below.
Void vApplicationMallocFailedHook(void);</description>
        </property>
        <property id="configUSE_DAEMON_TASK_STARTUP_HOOK" display="Use daemon task startup hook" default="0" type="checkbox">
            <option id="configUSE_DAEMON_TASK_STARTUP_HOOK.0" display="Disable" value="0"/>
            <option id="configUSE_DAEMON_TASK_STARTUP_HOOK.1" display="Enable" value="1"/>
            <description>Enable: Include daemon task startup hook.
Disable: Omit daemon task startup hook.</description>
        </property>
        <property id="configUSE_SB_COMPLETED_CALLBACK" display="Use stream buffer completed callback" default="0" type="checkbox">
            <option id="configUSE_SB_COMPLETED_CALLBACK.0" display="Disable" value="0"/>
            <option id="configUSE_SB_COMPLETED_CALLBACK.1" display="Enable" value="1"/>
            <description>Enable: Include callback function for send/receive completion.
Disable: Omit callback function for send/receive completion.
This allows the application to register callback functions that will be invoked when data is sent to or received from a stream buffer or message buffer.
This allows for notification-based processing without polling.</description>
        </property>
        <property id="configCHECK_FOR_STACK_OVERFLOW" display="Check for stack overflow" default="2" type="combobox">
            <option id="configCHECK_FOR_STACK_OVERFLOW.0" display="Not Check" value="0"/>
            <option id="configCHECK_FOR_STACK_OVERFLOW.1" display="Check by stack pointer" value="1"/>
            <option id="configCHECK_FOR_STACK_OVERFLOW.2" display="Check by tick value and stack pointer." value="2"/>
            <description>Not Check: Do not check for stack overflow.
Check by stack pointer: Check for stack overflow.
The stack overflow hook function is called if the stack pointer contain a value that is outside of the valid stack range.
Check by stack pointer and tick value: Check for stack overflow. 
The stack overflow hook function is called if the stack pointer contain a value that is outside of the valid stack range or any of the last 16 bytes not remain at their initial value.</description>
        </property>
        <property id="configGENERATE_RUN_TIME_STATS" display="Run time statistics" default="0" type="checkbox">
            <option id="configGENERATE_RUN_TIME_STATS.0" display="Disable" value="0"/>
            <option id="configGENERATE_RUN_TIME_STATS.1" display="Enable" value="1"/>
            <description>Enable: Include run time statistics collection.
Disable: Omit run time statistics collection.
When enabled, FreeRTOS will collect statistics about how much processing time each task has consumed.
This requires two additional macros to be defined: 
portCONFIGURE_TIMER_FOR_RUN_TIME_STATS() to initialize a timer/counter
portGET_RUN_TIME_COUNTER_VALUE() to read the current timer/counter value. 
The statistics can be retrieved using vTaskGetRunTimeStats().</description>
        </property>
        <property id="configUSE_TRACE_FACILITY" display="Use trace facility" default="1" type="checkbox">
            <option id="configUSE_TRACE_FACILITY.0" display="Disable" value="0"/>
            <option id="configUSE_TRACE_FACILITY.1" display="Enable" value="1"/>
            <description>Enable: Include additional structure members and functions for tracing.
Disable: Omit additional structure members and functions for tracing.
FreeRTOS includes extra fields in task control blocks and provides functions like uxTaskGetSystemState() that can be used by trace and visualization tools to monitor system behavior.</description>
        </property>
        <property id="configUSE_STATS_FORMATTING_FUNCTIONS" display="Use stats formatting functions" default="0" type="checkbox">
            <option id="configUSE_STATS_FORMATTING_FUNCTIONS.0" display="Disable" value="0"/>
            <option id="configUSE_STATS_FORMATTING_FUNCTIONS.1" display="Enable" value="1"/>
            <description>Enable: Include string formatting functions.
Disable: Omit string formatting functions.
String formatting functions vTaskList() and vTaskGetRunTimeStats() provide convenient formatted output of task information and runtime statistics. 
This feature requires configUSE_TRACE_FACILITY to also be enabled.</description>
        </property>
        <property id="configUSE_CO_ROUTINES" display="Co-routine" default="0" type="checkbox">
            <option id="configUSE_CO_ROUTINES.0" display="Disable" value="0"/>
            <option id="configUSE_CO_ROUTINES.1" display="Enable" value="1"/>
            <description>Enable: Include co-routine functionality in the build.
Disable: Omit co-routine functionality from the build.
To include co-routines croutine.c must be included in the project.</description>
        </property>
        <property id="configMAX_CO_ROUTINE_PRIORITIES" display="Maximum number of priorities to the application co-routines" default="2" type="textbox">
            <constraint display="Value must be an integer">testInteger("${configMAX_CO_ROUTINE_PRIORITIES}")</constraint>
            <constraint display="Value must be in the range 1 ~ 32">("${configMAX_CO_ROUTINE_PRIORITIES}" &gt;= 1) &amp;&amp; ("${configMAX_CO_ROUTINE_PRIORITIES}" &lt;= 32)</constraint>
            <description>Sets the number of priorities available to the application co-routines. 
Any number of co-routines can share the same priority. Tasks are prioritised separately -see configMAX_PRIORITIES.</description>
        </property>
        <property id="configASSERT" display="configASSERT function" default="do { if( ( x ) == 0 ) vAssertCalled(); } while( 0 )" type="textbox">
            <description>Defines the configASSERT function.</description>
        </property>
        <property id="configUSE_TASK_NOTIFICATIONS" display="Use task notifications" default="1" type="checkbox">
            <option id="configUSE_TASK_NOTIFICATIONS.0" display="Disable" value="0"/>
            <option id="configUSE_TASK_NOTIFICATIONS.1" display="Enable" value="1"/>
            <description>Enable: Use task notification.
Disable: Do not use task notification.</description>
        </property>
        <property id="configUSE_TASK_DPFPU_SUPPORT" display="Use double-precision floating-point unit (DPFPU) support" default="0" type="combobox">
            <option id="configUSE_TASK_DPFPU_SUPPORT.0" display="Disable DPFPU support" value="0"/>
            <option id="configUSE_TASK_DPFPU_SUPPORT.1" display="Enable or disable DPFPU support for each task" value="1"/>
            <option id="configUSE_TASK_DPFPU_SUPPORT.2" display="Enable DPFPU support for all tasks" value="2"/>
            <description>Disable DPFPU support: DPFPU instructions cannot be used because all tasks do not have DPFPU context. 
Enable or disable DPFPU support for each task: Tasks do not have DPFPU context by default. To enable DPFPU context in a task, you must call vPortTaskUsesDPFPU() in this task before using DPFPU instructions. 
Enable DPFPU support for all tasks: All tasks have DPFPU context by default.</description>
        </property>
        <property id="configUSE_MUTEXES" display="Mutex functionality" default="1" type="checkbox">
            <option id="configUSE_MUTEXES.0" display="Disable" value="0"/>
            <option id="configUSE_MUTEXES.1" display="Enable" value="1"/>
            <description>Enable: Include mutex functionality in the build.
Disable: Omit mutex functionality from the build.
Mutexes provide mutual exclusion with priority inheritance to help prevent priority inversion issues.
Readers should familiarise themselves with the differences between mutexes and binary semaphores in relation to the FreeRTOS functionality.</description>
        </property>
        <property id="configUSE_RECURSIVE_MUTEXES" display="Recursive mutex functionality" default="1" type="checkbox">
            <option id="configUSE_RECURSIVE_MUTEXES.0" display="Disable" value="0"/>
            <option id="configUSE_RECURSIVE_MUTEXES.1" display="Enable" value="1"/>
            <description>Enable: Include recursive mutex functionality in the build.
Disable: omit recursive mutex functionality from the build.
Recursive mutexes can be taken multiple times by the same task and must be released the same number of times.</description>
        </property>
        <property id="configUSE_COUNTING_SEMAPHORES" display="Counting semaphore functionality" default="1" type="checkbox">
            <option id="configUSE_COUNTING_SEMAPHORES.0" display="Disable" value="0"/>
            <option id="configUSE_COUNTING_SEMAPHORES.1" display="Enable" value="1"/>
            <description>Enable: Include counting semaphore functionality in the build.
Disable: Omit counting semaphore functionality from the build.
Counting semaphores maintain a count and can be used for resource management or event counting.</description>
        </property>
        <property id="configUSE_QUEUE_SETS" display="Queue set functionality" default="1" type="checkbox">
            <option id="configUSE_QUEUE_SETS.0" display="Disable" value="0"/>
            <option id="configUSE_QUEUE_SETS.1" display="Enable" value="1"/>
            <description>Enable: Include queue set functionality in the build.
Disable: Omit queue set functionality from the build.
Queue sets allow a task to block (pend) on multiple queues and semaphores simultaneously. 
When any queue or semaphore in the set receives data or becomes available, the blocked task is unblocked.</description>
        </property>
        <property id="configUSE_APPLICATION_TASK_TAG" display="Use application task tag" default="0" type="checkbox">
            <option id="configUSE_APPLICATION_TASK_TAG.0" display="Disable" value="0"/>
            <option id="configUSE_APPLICATION_TASK_TAG.1" display="Enable" value="1"/>
            <description>Enable: Include application task tag functionality. Makes vTaskSetApplicationTaskTag() and xTaskGetApplicationTaskTag() available.
Disable: Omit application task tag functionality. These functions will be unavailable.</description>
        </property>
        <property id="INCLUDE_vTaskPrioritySet" display="vTaskPrioritySet" default="1" type="checkbox">
            <option id="INCLUDE_vTaskPrioritySet.0" display="Disable" value="0"/>
            <option id="INCLUDE_vTaskPrioritySet.1" display="Enable" value="1"/>
            <description>Enable: Include the vTaskPrioritySet() API function.
Disable: Exclude the vTaskPrioritySet() API function from your build.
This function allows changing a task's priority at runtime.</description>
        </property>
        <property id="INCLUDE_uxTaskPriorityGet" display="uxTaskPriorityGet" default="1" type="checkbox">
            <option id="INCLUDE_uxTaskPriorityGet.0" display="Disable" value="0"/>
            <option id="INCLUDE_uxTaskPriorityGet.1" display="Enable" value="1"/>
            <description>Enable: Include the uxTaskPriorityGet() API function.
Disable: Exclude the uxTaskPriorityGet() API function from your build.
This function allows querying a task's current priority.</description>
        </property>
        <property id="INCLUDE_vTaskDelete" display="vTaskDelete" default="1" type="checkbox">
            <option id="INCLUDE_vTaskDelete.0" display="Disable" value="0"/>
            <option id="INCLUDE_vTaskDelete.1" display="Enable" value="1"/>
            <description>Enable: Include the vTaskDelete() API function.
Disable: Exclude the vTaskDelete() API function from your build.
This function allows deleting a task and freeing its resources.</description>
        </property>
        <property id="INCLUDE_vTaskSuspend" display="vTaskSuspend" default="1" type="checkbox">
            <option id="INCLUDE_vTaskSuspend.0" display="Disable" value="0"/>
            <option id="INCLUDE_vTaskSuspend.1" display="Enable" value="1"/>
            <description>Enable: Include the vTaskSuspend() and vTaskResume() API functions.
Disable: Exclude the vTaskSuspend() and vTaskResume() API functions from your build.
These functions allow suspending and resuming task execution. </description>
        </property>
        <property id="INCLUDE_xResumeFromISR" display="xResumeFromISR" default="1" type="checkbox">
            <option id="INCLUDE_xResumeFromISR.0" display="Disable" value="0"/>
            <option id="INCLUDE_xResumeFromISR.1" display="Enable" value="1"/>
            <description>Enable: Include the xResumeFromISR() API function
Disable: Exclude the xResumeFromISR() from your build</description>
        </property>
        <property id="INCLUDE_vTaskDelayUntil" display="vTaskDelayUntil" default="1" type="checkbox">
            <option id="INCLUDE_vTaskDelayUntil.0" display="Disable" value="0"/>
            <option id="INCLUDE_vTaskDelayUntil.1" display="Enable" value="1"/>
            <description>Enable: Include the vTaskDelayUntil() API function
Disable: Exclude the vTaskDelayUntil() from your build</description>
        </property>
        <property id="INCLUDE_vTaskDelay" display="vTaskDelay" default="1" type="checkbox">
            <option id="INCLUDE_vTaskDelay.0" display="Disable" value="0"/>
            <option id="INCLUDE_vTaskDelay.1" display="Enable" value="1"/>
            <description>Enable: Include the vTaskDelay() API function
Disable: Exclude the vTaskDelay() from your build</description>
        </property>
        <property id="INCLUDE_xTaskGetSchedulerState" display="xTaskGetSchedulerState" default="1" type="checkbox">
            <option id="INCLUDE_xTaskGetSchedulerState.0" display="Disable" value="0"/>
            <option id="INCLUDE_xTaskGetSchedulerState.1" display="Enable" value="1"/>
            <description>Enable: Include the xTaskGetSchedulerState() API function
Disable: Exclude the xTaskGetSchedulerState() from your build</description>
        </property>
        <property id="INCLUDE_xTaskGetCurrentTaskHandle" display="xTaskGetCurrentTaskHandle" default="1" type="checkbox">
            <option id="INCLUDE_xTaskGetCurrentTaskHandle.0" display="Disable" value="0"/>
            <option id="INCLUDE_xTaskGetCurrentTaskHandle.1" display="Enable" value="1"/>
            <description>Enable: Include the xTaskGetCurrentTaskHandle() API function
Disable: Exclude the xTaskGetCurrentTaskHandle() from your build</description>
        </property>
        <property id="INCLUDE_uxTaskGetStackHighWaterMark" display="uxTaskGetStackHighWaterMark" default="1" type="checkbox">
            <option id="INCLUDE_uxTaskGetStackHighWaterMark.0" display="Disable" value="0"/>
            <option id="INCLUDE_uxTaskGetStackHighWaterMark.1" display="Enable" value="1"/>
            <description>Enable: Include the uxTaskGetStackHighWaterMark() API function.
Disable: Exclude the uxTaskGetStackHighWaterMark() API function from your build.
This function returns the minimum amount of remaining stack space that was available to the task since the task started executing.</description>
        </property>
        <property id="INCLUDE_xTaskGetIdleTaskHandle" display="xTaskGetIdleTaskHandle" default="0" type="checkbox">
            <option id="INCLUDE_xTaskGetIdleTaskHandle.0" display="Disable" value="0"/>
            <option id="INCLUDE_xTaskGetIdleTaskHandle.1" display="Enable" value="1"/>
            <description>Enable: Include the xTaskGetIdleTaskHandle() API function.
Disable: Exclude the xTaskGetIdleTaskHandle() API function from your build.
This function returns the handle of the idle task.</description>
        </property>
        <property id="INCLUDE_eTaskGetState" display="eTaskGetState" default="1" type="checkbox">
            <option id="INCLUDE_eTaskGetState.0" display="Disable" value="0"/>
            <option id="INCLUDE_eTaskGetState.1" display="Enable" value="1"/>
            <description>Enable: Include the eTaskGetState() API function.
Disable: Exclude the eTaskGetState() API function from your build.
This function returns the state of a task at the time the function is called.</description>
        </property>
        <property id="INCLUDE_xEventGroupSetBitFromISR" display="xEventGroupSetBitFromISR" default="1" type="checkbox">
            <option id="INCLUDE_xEventGroupSetBitFromISR.0" display="Disable" value="0"/>
            <option id="INCLUDE_xEventGroupSetBitFromISR.1" display="Enable" value="1"/>
            <description>Enable: Include the xEventGroupSetBitFromISR() API function.
Disable: Exclude the xEventGroupSetBitFromISR() API function from your build.
This function allows setting event group bits from an interrupt service routine, enabling event-driven synchronization between ISRs and tasks.</description>
        </property>
        <property id="INCLUDE_xTimerPendFunctionCall" display="xTimerPendFunctionCall" default="0" type="checkbox">
            <option id="INCLUDE_xTimerPendFunctionCall.0" display="Disable" value="0"/>
            <option id="INCLUDE_xTimerPendFunctionCall.1" display="Enable" value="1"/>
            <description>Enable: Include the xTimerPendFunctionCall() API function.
Disable: Exclude the xTimerPendFunctionCall() API function from your build.
This function allows a function to be executed in the context of the timer service task.</description>
        </property>
        <property id="INCLUDE_xTaskAbortDelay" display="xTaskAbortDelay" default="0" type="checkbox">
            <option id="INCLUDE_xTaskAbortDelay.0" display="Disable" value="0"/>
            <option id="INCLUDE_xTaskAbortDelay.1" display="Enable" value="1"/>
            <description>Enable: Include the xTaskAbortDelay() API function.
Disable: Exclude the xTaskAbortDelay() API function from your build.
This function allows a task to be forced out of the Blocked state even if the event the task was waiting for has not occurred, and the task's timeout period has not expired.</description>
        </property>
        <property id="INCLUDE_xTaskGetHandle" display="xTaskGetHandle" default="0" type="checkbox">
            <option id="INCLUDE_xTaskGetHandle.0" display="Disable" value="0"/>
            <option id="INCLUDE_xTaskGetHandle.1" display="Enable" value="1"/>
            <description>Enable: Include the xTaskGetHandle() API function
Disable: Exclude the xTaskGetHandle() from your build</description>
        </property>
        <property id="INCLUDE_xTaskResumeFromISR" display="xTaskResumeFromISR" default="1" type="checkbox">
            <option id="INCLUDE_xTaskResumeFromISR.0" display="Disable" value="0"/>
            <option id="INCLUDE_xTaskResumeFromISR.1" display="Enable" value="1"/>
            <description>Enable: Include the xTaskResumeFromISR() API function
Disable: Exclude the xTaskResumeFromISR() from your build</description>
        </property>
    </configuration>
</module>